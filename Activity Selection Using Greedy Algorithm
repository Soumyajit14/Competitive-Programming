
#include <stdio.h>

int main() {
    int start[] = {1, 3, 0, 5, 8, 5};
    int finish[] = {2, 4, 6, 7, 9, 9};
    int n = 6;
    int i, last = 0;

    printf("Selected activities: A1 ");

    for (i = 1; i < n; i++) {
        if (start[i] >= finish[last]) {
            printf("A%d ", i + 1);
            last = i;
        }
    }

    return 0;
}
